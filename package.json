{
  "name": "dsh-novel-fanfic",
  "version": "0.2.1",
  "description": "把原著导入，就能拥有一套专属的同人创作资料库。人物关系、剧情经历、世界规则，随时查阅；你想改写的人物命运、关系和剧情，也能按本作设定记录下来。写作时帮你理清人物知情、时间线和场景细节，写完还能检查人物 OOC、设定冲突和剧情前后矛盾。原著只是参考，你的故事由你决定。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --check lib/service.mjs && node --check lib/canon-store.mjs && node --check lib/exports.mjs && node --check lib/mission.mjs && node --check lib/checker.mjs && node --check lib/compiler.mjs && node --check lib/canon-adapter.mjs && node --check lib/ingest.mjs && node --check lib/tool-schema.mjs",
    "eval": "node scripts/fanfic-eval.mjs",
    "eval:verify": "node scripts/fanfic-eval.mjs verify",
    "eval:check": "node scripts/fanfic-eval.mjs check",
    "eval:lookup": "node scripts/fanfic-eval.mjs lookup --all",
    "eval:smoke": "node scripts/fanfic-eval.mjs smoke",
    "canon": "node scripts/fanfic-canon.mjs",
    "perf": "node scripts/fanfic-perf.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "eval",
    "scripts",
    "fixtures",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "novel",
    "fanfic",
    "canon",
    "fic-canon",
    "au",
    "evaluation"
  ],
  "license": "MIT",
  "author": "DrizzleGig",
  "contributors": [
    {
      "name": "MiyueWinter",
      "email": "mingyue_11129@qq.com",
      "url": "https://github.com/MiyueWinter"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DrizzleGig/dsh-novel-fanfic.git"
  },
  "homepage": "https://github.com/DrizzleGig/dsh-novel-fanfic",
  "bugs": {
    "url": "https://github.com/DrizzleGig/dsh-novel-fanfic/issues"
  }
}
